# --- connection (required) -------------------------------------------------
OPENPROJECT_URL=https://openproject.example.com
OPENPROJECT_API_KEY=your-api-key
# Bearer auth instead of an API key (OAuth deployments)
# OPENPROJECT_OAUTH_TOKEN=

# --- blast radius ----------------------------------------------------------
# Serve only read tools
# OPENPROJECT_MCP_READ_ONLY=1
# Enable the membership-write tools
# OPENPROJECT_MCP_ADMIN_TOOLS=1
# Drop whole tool groups to cut prompt cost, e.g. meetings,news
# OPENPROJECT_MCP_DISABLE=

# --- files -----------------------------------------------------------------
# OPENPROJECT_MCP_DOWNLOAD_DIR=
# OPENPROJECT_MCP_MAX_DOWNLOAD_MB=100

# --- caching ---------------------------------------------------------------
# Seconds to cache near-static metadata (types, statuses, schemas)
# OPENPROJECT_MCP_CACHE_TTL=300

# --- TLS -------------------------------------------------------------------
# PEM bundle for a private CA; there is no verify-off switch
# OPENPROJECT_MCP_CA_BUNDLE=

# --- observability ---------------------------------------------------------
# OPENPROJECT_MCP_LOG_LEVEL=INFO
# OPENPROJECT_MCP_LOG_FORMAT=text   # or json
# OPENPROJECT_MCP_LOG_BODIES=0      # DEBUG-only body logging, development use
# OPENPROJECT_MCP_OTEL=0

# --- localization ----------------------------------------------------------
# Passed to OpenProject; validation messages come back in this locale
# OPENPROJECT_MCP_ACCEPT_LANGUAGE=en

# --- HTTP transport (--transport http) -------------------------------------
# OPENPROJECT_MCP_HTTP_HOST=127.0.0.1
# OPENPROJECT_MCP_HTTP_PORT=8000
# Comma-separated bearer tokens; startup gate for --transport http
# (the endpoint does not yet verify them per request — see README # Transports)
# OPENPROJECT_MCP_AUTH_TOKENS=
# Start HTTP transport without authentication (development only)
# OPENPROJECT_MCP_INSECURE=0

# --- advanced HTTP tuning --------------------------------------------------
# Timeouts (seconds), pool size and retry budget for calls to OpenProject
# OPENPROJECT_MCP_CONNECT_TIMEOUT=10
# OPENPROJECT_MCP_READ_TIMEOUT=30
# OPENPROJECT_MCP_WRITE_TIMEOUT=60
# OPENPROJECT_MCP_POOL_TIMEOUT=5
# OPENPROJECT_MCP_MAX_CONNECTIONS=10
# OPENPROJECT_MCP_MAX_RETRIES=3

# --- standard passthrough --------------------------------------------------
# HTTPS_PROXY / ALL_PROXY / NO_PROXY and OTEL_* are honored natively
